=LET(
  b, FILTER(B5:B502, B5:B502<>"", E5:E502<>""),
  d, FILTER(D5:D502, B5:B502<>"", E5:E502<>""),
  e, FILTER(E5:E502, B5:B502<>"", E5:E502<>""),
  eR, ARRAYFORMULA(ROUND(e*10,0)),
  majorAll, ARRAYFORMULA(INT(eR/10)),
  majors, SORT(UNIQUE(majorAll)),
  vseqRaw, REDUCE(
    "_seed_",
    majors,
    LAMBDA(acc, m,
      LET(
        maxMinor, MAX(ARRAYFORMULA(IF(majorAll=m, eR, 0))),
        rng, SEQUENCE(maxMinor-m*10+1,1,m*10,1),
        VSTACK(acc, rng)
      )
    )
  ),
  vseq, CHOOSEROWS(vseqRaw, SEQUENCE(ROWS(vseqRaw)-1,1,2,1)),
  escapedB, ARRAYFORMULA(SUBSTITUTE(SUBSTITUTE(SUBSTITUTE(b,"&","&amp;"),"<","&lt;"),">","&gt;")),
  blocksHtml, MAP(vseq, LAMBDA(v,
    LET(
      label, TEXT(v/10,"0.0"),
      itemsText, IFERROR(TEXTJOIN(CHAR(10), TRUE, ARRAYFORMULA(IF(eR=v, "• "&escapedB&" ("&d&")", ""))), ""),
      itemsHtml, IF(itemsText="", "", TEXTJOIN("", TRUE, ARRAYFORMULA("<div>"&SPLIT(itemsText, CHAR(10))&"</div>"))),
      "<div>"&label&"</div>"&itemsHtml
    )
  )),
  n, ROWS(vseq),
  finalHtml, REDUCE(
    "",
    SEQUENCE(n),
    LAMBDA(acc, i,
      LET(
        curMajor, INT(INDEX(vseq,i,1)/10),
        prevMajor, IF(i=1, curMajor, INT(INDEX(vseq,i-1,1)/10)),
        sep, IF(i=1, "",
              IF(curMajor<>prevMajor,
                "<br><div>─────</div><br>",
                "<br>"
              )
            ),
        acc & sep & INDEX(blocksHtml,i,1)
      )
    )
  ),
  "<br>" & finalHtml
)
