=LET(
  srcA, A5:A502,
  srcB, B5:B502,
  srcD, D5:D502,
  data, FILTER(HSTACK(srcA,srcB,srcD), srcB<>""),
  n, ROWS(data),
  result, REDUCE(
    HSTACK("_seed_","_seed_"),
    SEQUENCE(n),
    LAMBDA(acc,i,
      LET(
        ser, INDEX(data,i,1),
        nm, INDEX(data,i,2),
        gr, INDEX(data,i,3),
        rowOut, HSTACK(nm, IF(gr="4진","(4진)","")),
        IF(ser="",
          VSTACK(acc, rowOut),
          IF(i=1,
            VSTACK(acc, HSTACK("<"&ser&">",""), rowOut),
            VSTACK(acc, HSTACK("",""), HSTACK("<"&ser&">",""), rowOut)
          )
        )
      )
    )
  ),
  table, CHOOSEROWS(result, SEQUENCE(ROWS(result)-1,1,2)),
  TEXTJOIN(
    "",
    FALSE,
    {
      "<br>";
      "<div><a href=""https://m.dcinside.com/board/yavetwarch/1475496""><span style=""font-size: 22px;"">초본/4진 라인업 정리글</span></a></div>";
      "<br>";
      "<div>─────────</div>";
      "<br>";
      "<div>"&TEXT(NOW(),"yyyy. m. d h""시 ""m""분""")&" 수정 </div><br>";
      BYROW(
        table,
        LAMBDA(r,
          IF(INDEX(r,1,1)="",
            "<br>",
            "<div>"&
              SUBSTITUTE(
                SUBSTITUTE(
                  SUBSTITUTE(TEXTJOIN(" ",TRUE,r),"&","&amp;"),
                "<","&lt;"),
              ">","&gt;")
            &" </div>"
          )
        )
      );
      "<br><br>";
      "<div>초본 "&COUNTIFS(srcB,"*?",srcD,"초본")&"개 </div>";
      "<div>4진 "&COUNTIFS(srcB,"*?",srcD,"4진")&"개 </div>";
      "<br><br>";
      "<br><span><a href=""https://m.dcinside.com/board/yavetwarch/1499797""><b>버전별 초/4 업데이트 목록</b></a></span><div><br></div>"
    }
  )
)
