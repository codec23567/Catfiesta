/*
체크박스(F3, H3, I3, J3, M3)를 누를 때 실행될 메인 트리거 함수입니다.
※ M3은 이번 구조 개편과 무관한 별도 특수 시트에서 사용하는 트리거이므로 그대로 유지.
*/
function triggerByCheckbox(e) {
  if (!e) return;

  var sheet = e.source.getActiveSheet();
  var range = e.range;
  var cellAddress = range.getA1Notation();

  // F3: 닉네임/날짜 추출 (GitHub Actions)
  if (cellAddress === 'F3' && range.getValue() === true) {
    triggerCrawler(sheet.getName());
    sheet.getRange('F3').setValue(false);
  }

  // H3: 모음집관리 (캐릭터별 모음집 게시글 검증 + 수정)
  if (cellAddress === 'H3' && range.getValue() === true) {
    runModify_normal_bl(sheet.getName());
    sheet.getRange('H3').setValue(false);
  }

  // I3: 시리즈관리 (시리즈 모음집 게시글 수정, C3 URL + I5 완성본 HTML)
  if (cellAddress === 'I3' && range.getValue() === true) {
    runModify_html(sheet.getName());
    sheet.getRange('I3').setValue(false);
  }

  // J3: 이미지 추출
  if (cellAddress === 'J3' && range.getValue() === true) {
    runImageExtractor(sheet.getName());
    sheet.getRange('J3').setValue(false);
  }

  // M3: 별도 특수 시트용 - 일반 에디터 게시글 수정 (이번 개편과 무관, 그대로 유지)
  if (cellAddress === 'M3' && range.getValue() === true) {
    runModify_normal(sheet.getName());
    sheet.getRange('M3').setValue(false);
  }

}

