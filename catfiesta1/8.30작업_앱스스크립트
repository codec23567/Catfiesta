function runModify_normal_bl(sheetName) {
  // H3 "모음집관리" 트리거
  //
  // 구조: H{그룹시작행}=모음집 링크 / H{그룹시작행+1}=게시할 내용 / H{그룹시작행+2}=완료 날짜
  //
  // GitHub Actions에 신호를 보내기 전, 완료 날짜(H+2)가 비어있는 그룹만
  // 게시할 내용(H+1)을 새로 구성해서 덮어쓴다 (기존 내용이 있어도 무조건 갱신).
  // 완료 날짜가 이미 있는 그룹은 건드리지 않는다.
  //
  // [최적화] 셀 단위로 읽고/쓰지 않고, B~H열 전체를 한 번에 읽어서(getValues)
  // 메모리에서 계산한 뒤 H열 전체를 한 번에 써서(setValues) 시트 API 호출을 최소화.

  const ss = SpreadsheetApp.getActiveSpreadsheet();
  const sheet = ss.getSheetByName(sheetName);

  const START_ROW = 5;
  const NAME_COL = 2;  // B열
  const LINK_COL = 3;  // C열 (블록 내 상대 인덱스 1)
  const TYPE_COL = 4;  // D열 (블록 내 상대 인덱스 2)
  const H_COL = 8;     // H열 (블록 내 상대 인덱스 6)
  const BLOCK_WIDTH = H_COL - NAME_COL + 1; // B~H = 7열

  const lastRow = sheet.getLastRow();

  if (lastRow >= START_ROW) {
    const numRows = lastRow - START_ROW + 1;

    // B~H열 전체를 한 번에 읽기 (시트 API 호출 1회)
    const data = sheet.getRange(START_ROW, NAME_COL, numRows, BLOCK_WIDTH).getValues();

    const idxName = 0;             // B
    const idxLink = LINK_COL - NAME_COL;   // C → 1
    const idxType = TYPE_COL - NAME_COL;   // D → 2
    const idxH = H_COL - NAME_COL;         // H → 6

    for (let i = 0; i < data.length; i++) {
      const name = String(data[i][idxName] || "").trim();
      if (!name) continue; // 그룹 시작 행이 아니면 건너뜀

      // 다음 그룹 시작 행(다음 이름이 나오는 인덱스) 찾기
      let nextIndex = data.length;
      for (let j = i + 1; j < data.length; j++) {
        if (String(data[j][idxName] || "").trim() !== "") {
          nextIndex = j;
          break;
        }
      }

      const link = data[i][idxH];
      if (!link) continue; // 모음집 링크가 없는 그룹은 대상 아님

      const dateRowIndex = i + 2;
      const dateValue = dateRowIndex < data.length ? data[dateRowIndex][idxH] : "";

      // 완료 날짜(H+2)가 비어있는 그룹만 내용(H+1)을 새로 구성해서 덮어씀
      if (!dateValue) {
        // 그룹 범위(i ~ nextIndex-1) 내 링크/육성도 수집
        const links = [];
        const types = [];
        for (let row = i; row < nextIndex; row++) {
          const linkValue = String(data[row][idxLink] || "").trim();
          if (linkValue) {
            links.push(linkValue);
            types.push(String(data[row][idxType] || "").trim());
          }
        }

        const content = buildCollectionPostContent(name, links, types);

        const contentRowIndex = i + 1;
        if (contentRowIndex < data.length) {
          data[contentRowIndex][idxH] = content; // 메모리 상에서만 갱신 (아직 시트에 안 씀)
        }
      }
    }

    // H열 전체를 한 번에 써서 반영 (시트 API 호출 1회)
    const hColumnValues = data.map(function (row) {
      return [row[idxH]];
    });
    sheet.getRange(START_ROW, H_COL, numRows, 1).setValues(hColumnValues);
  }

  // ---- 신호 전송 (기존 m_normal_bl.yml 재활용) ----
  const token = PropertiesService.getScriptProperties().getProperty("GITHUB_PAT");

  const url =
    "https://api.github.com/repos/codec23567/catfiestagitsheet235/actions/workflows/m_normal_bl.yml/dispatches";

  const options = {
    method: "post",
    contentType: "application/json",
    headers: {
      Authorization: "Bearer " + token,
      Accept: "application/vnd.github+json"
    },
    payload: JSON.stringify({
      ref: "main",
      inputs: {
        sheet_name: sheetName
      }
    }),
    muteHttpExceptions: true
  };

  const response = UrlFetchApp.fetch(url, options);

  Logger.log(response.getResponseCode());
  Logger.log(response.getContentText());
}

/*
 * 그룹(캐릭터)의 게시 내용을 구성하는 함수.
 * 기존 H5 배열 수식(=MAP(...))의 로직을 그대로 옮긴 순수 계산 함수.
 * (배열 수식은 해당 영역에 값을 직접 입력하면 깨지므로, 스크립트 계산 방식으로 전환)
 *
 * - 링크가 3개 미만이면 빈 문자열
 * - 3개 이상이면, 육성도가 바뀔 때만 "이름(단계)" 라벨을 붙이고
 *   나머지는 링크만 이어붙여서 전체를 "§"로 연결
 *
 * name: 캐릭터 이름
 * links: 그룹 내 링크 배열 (빈 값 제외됨)
 * types: links와 같은 순서의 육성도 배열
 */
function buildCollectionPostContent(name, links, types) {
  const n = links.length;
  if (n < 3) return "";

  const tokens = [];
  for (let i = 0; i < n; i++) {
    if (i === 0 || types[i] !== types[i - 1]) {
      tokens.push(name + "(" + types[i] + ")");
      tokens.push(links[i]);
    } else {
      tokens.push(links[i]);
    }
  }

  return tokens.join("§");
}
